# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ADMIN_KEY: Secure password/secret key required for accessing the admin panel and managing fleet/bank details.
ADMIN_KEY="YOUR_ADMIN_PASSWORD_OR_KEY"

# JWT_SECRET: (Optional) Secret key used to sign and verify stateless admin session tokens.
JWT_SECRET="YOUR_JWT_SECRET_KEY"

# ADMIN_EMAILS: Comma-separated list of email addresses authorized for Firebase Admin authentication.
ADMIN_EMAILS="jilansoftacademy@gmail.com"

# ==============================================================================
# SUPABASE POSTGRESQL & STORAGE CONFIGURATION (Recommended for Hosted Production)
# ==============================================================================
# 1. DATABASE_URL:
#    Found in Supabase Dashboard -> Project Settings -> Database -> Connection string (URI)
#    Choose "Transaction Pooler" (port 6543) or "Session Pooler" (port 5432).
#    Example: postgresql://postgres.[PROJECT_REF]:[YOUR_PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[YOUR_PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require"

# 2. SUPABASE PROJECT URL & API KEYS (Used for Supabase Storage for Visa PDFs & Documents):
#    Found in Supabase Dashboard -> Project Settings -> API
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your_supabase_service_role_key"
SUPABASE_ANON_KEY="your_supabase_anon_key"
SUPABASE_STORAGE_BUCKET="website-files"

# ==============================================================================
# GOOGLE CLOUD SQL POSTGRESQL CREDENTIALS (Fallback / Secondary Database)
# ==============================================================================
SQL_HOST="localhost"
SQL_USER="postgres"
SQL_PASSWORD=""
SQL_DB_NAME="zonetourism"

# Company Official Contact Configuration
COMPANY_EMAIL="admin@zonetourism.ae"
COMPANY_WHATSAPP="971555586359"
COMPANY_PHONE="+971 4 222 6182"

# EmailJS Integration Keys (Client-side integration)
VITE_EMAILJS_SERVICE_ID="your_service_id"
VITE_EMAILJS_PUBLIC_KEY="your_public_key"
VITE_EMAILJS_TEMPLATE_VISA_APPLICATION="your_visa_application_template_id"
VITE_EMAILJS_TEMPLATE_CAR_RENTAL="your_car_rental_template_id"
